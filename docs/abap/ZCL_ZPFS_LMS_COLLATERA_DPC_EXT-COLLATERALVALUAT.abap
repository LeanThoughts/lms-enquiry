*&---------------------------------------------------------------------*
*& ZCL_ZPFS_LMS_COLLATERA_DPC_EXT — CollateralValuationSet (ZCOL_VALUATION)
*&
*& Redefinitions of the five SEGW-generated methods of entity set
*& CollateralValuationSet (entity type CollateralValuation, the "Valuation"
*& tab of a checklist condition), implemented through ZCL_LMS_COL_VALUATION
*& so that the portal and the SAP GUI tab maintain ZCOL_VALUATION the same
*& way.
*&
*& The generated method names are the entity set name cut to 16 characters:
*& COLLATERALVALUAT_CREATE_ENTITY, _UPDATE_ENTITY, _DELETE_ENTITY,
*& _GET_ENTITY, _GET_ENTITYSET — use the names SEGW produced in your system.
*&
*& Called by the portal (CollateralSapIntegrationService) like the other
*& child sets:
*&   POST   CollateralValuationSet                              (mode C)
*&   PUT    CollateralValuationSet(ZidNo='…',ItemId=guid'…',PtlId='…') (mode U)
*&   DELETE CollateralValuationSet(ZidNo='…',ItemId=guid'…',PtlId='…') (mode D)
*& The body carries ZidNo, Bukrs, Ranl, SerialNo, NomValue, AstValue,
*& EnteredAmount, ValDate, NomValueCurr, Remarks, PtlId (= the portal
*& record's UUID), PtlDocuId, Sourceofentry = 'PORTAL'.
*&
*& ITEM_ID is generated by ZCL_LMS_COL_VALUATION->CREATE_SNG and never known
*& to the portal: update and delete therefore locate the row by ZID_NO +
*& PTL_ID (ItemId in the URL is the nil GUID), exactly as UPDATE_ITEM /
*& DELETE_ITEM of this class do for the other children. => In SEGW, PtlId
*& must be a key of CollateralValuation (see the note at the end).
*&---------------------------------------------------------------------*

*======================================================================*
* 1. CLASS DEFINITION — add to the PRIVATE SECTION
*======================================================================*
*  constants C_TAB_VAL type TABNAME value 'ZCOL_VALUATION'. "#EC NOTEXT
*
*  methods READ_VALUATION_BY_KEY
*    importing
*      !IT_KEY_TAB type /IWBEP/T_MGW_NAME_VALUE_PAIR
*    exporting
*      !ES_ROW   type ZCOL_VALUATION
*      !EV_ZIDNO type ZDE_ID_NO
*    raising
*      /IWBEP/CX_MGW_BUSI_EXCEPTION .

*======================================================================*
* 2. CLASS IMPLEMENTATION
*======================================================================*

* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->READ_VALUATION_BY_KEY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [<---] ES_ROW                         TYPE        ZCOL_VALUATION
* | [<---] EV_ZIDNO                       TYPE        ZDE_ID_NO
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD read_valuation_by_key.
    " The row of ZCOL_VALUATION addressed by the OData key: ZidNo + PtlId (the
    " portal's id) when PtlId is given, else ZidNo + ItemId (SAP's GUID, e.g.
    " for a row that was created in the GUI and is read by the portal).
    DATA: lv_itemid TYPE guid_16,
          lv_ptlid  TYPE zde_ptl_id,
          lv_key    TYPE string,
          lv_nil    TYPE guid_16.

    CLEAR: es_row, ev_zidno.
    ev_zidno  = get_key_zidno( it_key_tab ).
    lv_itemid = get_key_itemid( it_key_tab ).
    lv_ptlid  = get_key_ptlid( it_key_tab ).

    IF ev_zidno IS INITIAL.
      mo_context->get_message_container( )->add_message_text_only(
        iv_msg_type = 'E' iv_msg_text = 'Checklist Id No. (ZidNo) is required' ).
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_busi_exception
        EXPORTING
          message_container = mo_context->get_message_container( )
          http_status_code  = /iwbep/cx_mgw_busi_exception=>gcs_http_status_codes-bad_request.
    ENDIF.

    IF lv_ptlid IS NOT INITIAL.
      SELECT SINGLE * FROM zcol_valuation INTO es_row
        WHERE zid_no = ev_zidno AND ptl_id = lv_ptlid.
    ELSEIF lv_itemid IS NOT INITIAL AND lv_itemid <> lv_nil.
      SELECT SINGLE * FROM zcol_valuation INTO es_row
        WHERE zid_no = ev_zidno AND item_id = lv_itemid.
    ELSE.
      sy-subrc = 4.
    ENDIF.
    IF sy-subrc <> 0.
      CONCATENATE ev_zidno '/' lv_ptlid INTO lv_key.
      raise_not_found( iv_tabname = c_tab_val iv_key = lv_key ).
    ENDIF.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Protected Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->COLLATERALVALUAT_CREATE_ENTITY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_ENTITY_NAME                 TYPE        STRING
* | [--->] IV_ENTITY_SET_NAME             TYPE        STRING
* | [--->] IV_SOURCE_NAME                 TYPE        STRING
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [--->] IO_TECH_REQUEST_CONTEXT        TYPE REF TO /IWBEP/IF_MGW_REQ_ENTITY_C(optional)
* | [--->] IT_NAVIGATION_PATH             TYPE        /IWBEP/T_MGW_NAVIGATION_PATH
* | [--->] IO_DATA_PROVIDER               TYPE REF TO /IWBEP/IF_MGW_ENTRY_PROVIDER(optional)
* | [<---] ER_ENTITY                      TYPE        ZCL_ZPFS_LMS_COLLATERA_MPC=>TS_COLLATERALVALUATION
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD collateralvaluat_create_entity.
    " POST CollateralValuationSet — a valuation created in the portal (mode C).
    DATA: ls_row       TYPE zcol_valuation,
          ls_existing  TYPE zcol_valuation,
          ls_header    TYPE zpfs_ln_chklt_dt,
          lt_valuation TYPE zcol_tt_valuation,
          ls_valuation TYPE zcol_valuation,
          lv_zidno     TYPE zde_id_no,
          lv_max_ser   TYPE zcol_valuation-serial_no,
          lo_valuation TYPE REF TO zcl_lms_col_valuation,
          lo_msg       TYPE REF TO /iwbep/if_message_container.

    lo_msg = mo_context->get_message_container( ).

    " payload into the entity structure, then into a DB row of the table
    io_data_provider->read_entry_data( IMPORTING es_data = er_entity ).
    MOVE-CORRESPONDING er_entity TO ls_row.

    " parent key: from navigation (POST ChecklistHeaderSet('…')/To…) wins over the payload
    lv_zidno = get_key_zidno( it_key_tab ).
    IF lv_zidno IS NOT INITIAL.
      ls_row-zid_no = lv_zidno.
    ENDIF.
    IF ls_row-zid_no IS INITIAL.
      lo_msg->add_message_text_only(
        iv_msg_type = 'E' iv_msg_text = 'Checklist Id No. (ZidNo) is required' ).
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_busi_exception
        EXPORTING
          message_container = lo_msg
          http_status_code  = /iwbep/cx_mgw_busi_exception=>gcs_http_status_codes-bad_request.
    ENDIF.
    IF ls_row-ptl_id IS INITIAL.
      lo_msg->add_message_text_only(
        iv_msg_type = 'E' iv_msg_text = 'Portal Id (PtlId) is required' ).
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_busi_exception
        EXPORTING
          message_container = lo_msg
          http_status_code  = /iwbep/cx_mgw_busi_exception=>gcs_http_status_codes-bad_request.
    ENDIF.
    IF ls_row-val_date IS INITIAL.
      lo_msg->add_message_text_only(
        iv_msg_type = 'E' iv_msg_text = 'Valuation Date (ValDate) is required' ).
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_busi_exception
        EXPORTING
          message_container = lo_msg
          http_status_code  = /iwbep/cx_mgw_busi_exception=>gcs_http_status_codes-bad_request.
    ENDIF.

    " the checklist header must exist; company code / contract come from it when not sent
    SELECT SINGLE * FROM zpfs_ln_chklt_dt INTO ls_header WHERE zid_no = ls_row-zid_no.
    IF sy-subrc <> 0.
      raise_not_found( iv_tabname = c_tab_header iv_key = ls_row-zid_no ).
    ENDIF.
    IF ls_row-bukrs IS INITIAL.
      ls_row-bukrs = ls_header-bukrs.
    ENDIF.
    IF ls_row-bukrs IS INITIAL.
      ls_row-bukrs = zcc_lms_constants=>company_code.
    ENDIF.
    IF ls_row-ranl IS INITIAL.
      ls_row-ranl = ls_header-ranl.
    ENDIF.
    IF ls_row-nom_value_curr IS INITIAL.
      ls_row-nom_value_curr = 'INR'.
    ENDIF.
    IF ls_row-sourceofentry IS INITIAL.
      ls_row-sourceofentry = 'PORTAL'.
    ENDIF.

    CREATE OBJECT lo_valuation.

    " Idempotent: the portal resends a failed create on its next sweep. A row
    " with this portal id already exists -> update it instead of a duplicate.
    SELECT SINGLE * FROM zcol_valuation INTO ls_existing
      WHERE zid_no = ls_row-zid_no AND ptl_id = ls_row-ptl_id.
    IF sy-subrc = 0.
      ls_row-item_id = ls_existing-item_id.
      IF ls_row-serial_no IS INITIAL.
        ls_row-serial_no = ls_existing-serial_no.
      ENDIF.
      lo_valuation->update_sng(
        EXPORTING iv_id_no     = ls_row-zid_no
                  iv_ranl      = ls_row-ranl
                  iv_bukrs     = ls_row-bukrs
                  is_valuation = ls_row
        IMPORTING et_valuation = lt_valuation ).
      write_change_doc( iv_tabname = c_tab_val iv_indicator = 'U'
                        is_new = ls_row is_old = ls_existing ).
    ELSE.
      " serial number: the portal numbers 1, 2, 3 … per collateral; when none
      " is sent, continue after the highest number of the checklist item
      IF ls_row-serial_no IS INITIAL.
        SELECT MAX( serial_no ) FROM zcol_valuation INTO lv_max_ser
          WHERE zid_no = ls_row-zid_no.
        ls_row-serial_no = lv_max_ser + 1.
      ENDIF.
      " CREATE_SNG generates ITEM_ID, sets ZID_NO, BUKRS, RANL, CREATED_AT/BY
      " and inserts the row; its SOURCEOFENTRY (sy-tcode, empty for Gateway)
      " is set back to the portal's value afterwards
      lo_valuation->create_sng(
        EXPORTING iv_id_no     = ls_row-zid_no
                  iv_ranl      = ls_row-ranl
                  iv_bukrs     = ls_row-bukrs
                  is_valuation = ls_row
        IMPORTING et_valuation = lt_valuation ).
      UPDATE zcol_valuation SET sourceofentry = ls_row-sourceofentry
        WHERE zid_no = ls_row-zid_no AND ptl_id = ls_row-ptl_id.
      write_change_doc( iv_tabname = c_tab_val iv_indicator = 'I'
                        is_new = ls_row is_old = ls_row ).
    ENDIF.

    " response = the stored row (incl. the generated ItemId and admin fields)
    READ TABLE lt_valuation INTO ls_valuation WITH KEY ptl_id = ls_row-ptl_id.
    IF sy-subrc = 0.
      MOVE-CORRESPONDING ls_valuation TO er_entity.
    ELSE.
      MOVE-CORRESPONDING ls_row TO er_entity.
    ENDIF.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Protected Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->COLLATERALVALUAT_UPDATE_ENTITY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_ENTITY_NAME                 TYPE        STRING
* | [--->] IV_ENTITY_SET_NAME             TYPE        STRING
* | [--->] IV_SOURCE_NAME                 TYPE        STRING
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [--->] IO_TECH_REQUEST_CONTEXT        TYPE REF TO /IWBEP/IF_MGW_REQ_ENTITY_U(optional)
* | [--->] IT_NAVIGATION_PATH             TYPE        /IWBEP/T_MGW_NAVIGATION_PATH
* | [--->] IO_DATA_PROVIDER               TYPE REF TO /IWBEP/IF_MGW_ENTRY_PROVIDER(optional)
* | [<---] ER_ENTITY                      TYPE        ZCL_ZPFS_LMS_COLLATERA_MPC=>TS_COLLATERALVALUATION
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD collateralvaluat_update_entity.
    " PUT CollateralValuationSet(ZidNo='…',ItemId=guid'…',PtlId='…') — a changed valuation (mode U).
    DATA: ls_old       TYPE zcol_valuation,
          ls_row       TYPE zcol_valuation,
          lv_zidno     TYPE zde_id_no,
          lt_valuation TYPE zcol_tt_valuation,
          ls_valuation TYPE zcol_valuation,
          lo_valuation TYPE REF TO zcl_lms_col_valuation.

    read_valuation_by_key(
      EXPORTING it_key_tab = it_key_tab
      IMPORTING es_row     = ls_old
                ev_zidno   = lv_zidno ).

    " payload overwrites the business fields; keys, ITEM_ID, serial number and
    " the portal id are protected (UPDATE_SNG itself keeps CREATED_AT/BY and
    " SOURCEOFENTRY of the stored row)
    ls_row = ls_old.
    io_data_provider->read_entry_data( IMPORTING es_data = er_entity ).
    MOVE-CORRESPONDING er_entity TO ls_row.
    ls_row-zid_no  = ls_old-zid_no.
    ls_row-item_id = ls_old-item_id.
    ls_row-ptl_id  = ls_old-ptl_id.
    IF ls_row-bukrs IS INITIAL.
      ls_row-bukrs = ls_old-bukrs.
    ENDIF.
    IF ls_row-ranl IS INITIAL.
      ls_row-ranl = ls_old-ranl.
    ENDIF.
    IF ls_row-serial_no IS INITIAL.
      ls_row-serial_no = ls_old-serial_no.
    ENDIF.
    IF ls_row-nom_value_curr IS INITIAL.
      ls_row-nom_value_curr = ls_old-nom_value_curr.
    ENDIF.

    CREATE OBJECT lo_valuation.
    lo_valuation->update_sng(
      EXPORTING iv_id_no     = ls_row-zid_no
                iv_ranl      = ls_row-ranl
                iv_bukrs     = ls_row-bukrs
                is_valuation = ls_row
      IMPORTING et_valuation = lt_valuation ).

    write_change_doc( iv_tabname = c_tab_val iv_indicator = 'U'
                      is_new = ls_row is_old = ls_old ).

    READ TABLE lt_valuation INTO ls_valuation WITH KEY item_id = ls_row-item_id.
    IF sy-subrc = 0.
      MOVE-CORRESPONDING ls_valuation TO er_entity.
    ELSE.
      MOVE-CORRESPONDING ls_row TO er_entity.
    ENDIF.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Protected Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->COLLATERALVALUAT_DELETE_ENTITY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_ENTITY_NAME                 TYPE        STRING
* | [--->] IV_ENTITY_SET_NAME             TYPE        STRING
* | [--->] IV_SOURCE_NAME                 TYPE        STRING
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [--->] IO_TECH_REQUEST_CONTEXT        TYPE REF TO /IWBEP/IF_MGW_REQ_ENTITY_D(optional)
* | [--->] IT_NAVIGATION_PATH             TYPE        /IWBEP/T_MGW_NAVIGATION_PATH
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD collateralvaluat_delete_entity.
    " DELETE CollateralValuationSet(ZidNo='…',ItemId=guid'…',PtlId='…') — a deleted valuation (mode D).
    DATA: ls_old       TYPE zcol_valuation,
          lv_zidno     TYPE zde_id_no,
          lt_valuation TYPE zcol_tt_valuation,
          lo_valuation TYPE REF TO zcl_lms_col_valuation.

    read_valuation_by_key(
      EXPORTING it_key_tab = it_key_tab
      IMPORTING es_row     = ls_old
                ev_zidno   = lv_zidno ).

    " DELETE_SNG deletes by ZID_NO + ITEM_ID (SAP's GUID, taken from the row found by PtlId)
    CREATE OBJECT lo_valuation.
    lo_valuation->delete_sng(
      EXPORTING iv_id_no     = ls_old-zid_no
                iv_item_id   = ls_old-item_id
      IMPORTING et_valuation = lt_valuation ).

    write_change_doc( iv_tabname = c_tab_val iv_indicator = 'D'
                      is_new = ls_old is_old = ls_old ).
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Protected Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->COLLATERALVALUAT_GET_ENTITY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_ENTITY_NAME                 TYPE        STRING
* | [--->] IV_ENTITY_SET_NAME             TYPE        STRING
* | [--->] IV_SOURCE_NAME                 TYPE        STRING
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [--->] IO_REQUEST_OBJECT              TYPE REF TO /IWBEP/IF_MGW_REQ_ENTITY(optional)
* | [--->] IO_TECH_REQUEST_CONTEXT        TYPE REF TO /IWBEP/IF_MGW_REQ_ENTITY(optional)
* | [--->] IT_NAVIGATION_PATH             TYPE        /IWBEP/T_MGW_NAVIGATION_PATH
* | [<---] ER_ENTITY                      TYPE        ZCL_ZPFS_LMS_COLLATERA_MPC=>TS_COLLATERALVALUATION
* | [<---] ES_RESPONSE_CONTEXT            TYPE        /IWBEP/IF_MGW_APPL_SRV_RUNTIME=>TY_S_MGW_RESPONSE_ENTITY_CNTXT
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD collateralvaluat_get_entity.
    " GET CollateralValuationSet(ZidNo='…',ItemId=guid'…'[,PtlId='…'])
    DATA: ls_row   TYPE zcol_valuation,
          lv_zidno TYPE zde_id_no.

    read_valuation_by_key(
      EXPORTING it_key_tab = it_key_tab
      IMPORTING es_row     = ls_row
                ev_zidno   = lv_zidno ).

    MOVE-CORRESPONDING ls_row TO er_entity.
  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Protected Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->COLLATERALVALUAT_GET_ENTITYSET
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_ENTITY_NAME                 TYPE        STRING
* | [--->] IV_ENTITY_SET_NAME             TYPE        STRING
* | [--->] IV_SOURCE_NAME                 TYPE        STRING
* | [--->] IT_FILTER_SELECT_OPTIONS       TYPE        /IWBEP/T_MGW_SELECT_OPTION
* | [--->] IS_PAGING                      TYPE        /IWBEP/S_MGW_PAGING
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [--->] IT_NAVIGATION_PATH             TYPE        /IWBEP/T_MGW_NAVIGATION_PATH
* | [--->] IT_ORDER                       TYPE        /IWBEP/T_MGW_SORTING_ORDER
* | [--->] IV_FILTER_STRING               TYPE        STRING
* | [--->] IV_SEARCH_STRING               TYPE        STRING
* | [--->] IO_TECH_REQUEST_CONTEXT        TYPE REF TO /IWBEP/IF_MGW_REQ_ENTITYSET(optional)
* | [<---] ET_ENTITYSET                   TYPE        ZCL_ZPFS_LMS_COLLATERA_MPC=>TT_COLLATERALVALUATION
* | [<---] ES_RESPONSE_CONTEXT            TYPE        /IWBEP/IF_MGW_APPL_SRV_RUNTIME=>TY_S_MGW_RESPONSE_CONTEXT
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD collateralvaluat_get_entityset.
    " ChecklistHeaderSet('912')/ToCollateralValuations          -> by checklist item (navigation key)
    " CollateralValuationSet?$filter=ZidNo eq '912'             -> by checklist item
    " CollateralValuationSet?$filter=Bukrs eq 'PFS' and Ranl eq '…' -> every valuation of the loan
    DATA: ls_so        LIKE LINE OF it_filter_select_options,
          ls_rng       TYPE /iwbep/s_cod_select_option,
          lv_zidno     TYPE zde_id_no,
          lv_bukrs     TYPE bukrs,
          lv_ranl      TYPE ranl,
          lv_ptlid     TYPE zde_ptl_id,
          lt_valuation TYPE zcol_tt_valuation,
          ls_valuation TYPE zcol_valuation,
          ls_entity    TYPE zcl_zpfs_lms_collatera_mpc=>ts_collateralvaluation,
          lo_valuation TYPE REF TO zcl_lms_col_valuation.

    lv_zidno = get_key_zidno( it_key_tab ).
    LOOP AT it_filter_select_options INTO ls_so.
      READ TABLE ls_so-select_options INTO ls_rng INDEX 1.
      IF sy-subrc <> 0 OR ls_rng-option <> 'EQ'.
        CONTINUE.
      ENDIF.
      CASE ls_so-property.
        WHEN 'ZidNo'. IF lv_zidno IS INITIAL. lv_zidno = ls_rng-low. ENDIF.
        WHEN 'Bukrs'. lv_bukrs = ls_rng-low.
        WHEN 'Ranl'.  lv_ranl  = ls_rng-low.
        WHEN 'PtlId'. lv_ptlid = ls_rng-low.
      ENDCASE.
    ENDLOOP.

    CREATE OBJECT lo_valuation.
    IF lv_zidno IS NOT INITIAL.
      lo_valuation->get_by_id(
        EXPORTING iv_id_no     = lv_zidno
        IMPORTING et_valuation = lt_valuation ).
    ELSEIF lv_ranl IS NOT INITIAL.
      IF lv_bukrs IS INITIAL.
        lv_bukrs = zcc_lms_constants=>company_code.
      ENDIF.
      lo_valuation->get_by_loan_contract(
        EXPORTING iv_bukrs     = lv_bukrs
                  iv_ranl      = lv_ranl
        IMPORTING et_valuation = lt_valuation ).
    ELSE.
      mo_context->get_message_container( )->add_message_text_only(
        iv_msg_type = 'E' iv_msg_text = 'Filter by ZidNo, or by Bukrs and Ranl' ).
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_busi_exception
        EXPORTING
          message_container = mo_context->get_message_container( )
          http_status_code  = /iwbep/cx_mgw_busi_exception=>gcs_http_status_codes-bad_request.
    ENDIF.

    LOOP AT lt_valuation INTO ls_valuation.
      IF lv_ptlid IS NOT INITIAL AND ls_valuation-ptl_id <> lv_ptlid.
        CONTINUE.
      ENDIF.
      CLEAR ls_entity.
      MOVE-CORRESPONDING ls_valuation TO ls_entity.
      APPEND ls_entity TO et_entityset.
    ENDLOOP.

    " default order: checklist item, then serial number
    IF it_order IS INITIAL.
      SORT et_entityset BY zid_no serial_no.
    ELSE.
      /iwbep/cl_mgw_data_util=>orderby( EXPORTING it_order = it_order
                                        CHANGING  ct_data  = et_entityset ).
    ENDIF.
    es_response_context-inlinecount = lines( et_entityset ).
    IF is_paging-top > 0 OR is_paging-skip > 0.
      /iwbep/cl_mgw_data_util=>paging( EXPORTING is_paging = is_paging
                                       CHANGING  ct_data   = et_entityset ).
    ENDIF.
    IF io_tech_request_context IS BOUND AND io_tech_request_context->has_inlinecount( ) = abap_false.
      CLEAR es_response_context-inlinecount.
    ENDIF.
  ENDMETHOD.

*======================================================================*
* 3. SEGW — CollateralValuation
*======================================================================*
* Keys today: ZidNo, ItemId. ItemId is generated by CREATE_SNG and is not
* known to the portal, which addresses a row by its own PtlId:
*   -> mark PtlId as a key as well (ZidNo + ItemId + PtlId), as for the
*      other child sets, regenerate the runtime objects and re-register the
*      service. The portal sends the nil GUID for ItemId in the URL; the
*      methods above find the row by ZidNo + PtlId.
* Add to BUILD_WHERE (optional, for $filter on the other sets too):
*        WHEN 'PtlId'.      lv_field = 'PTL_ID'.
*        WHEN 'SerialNo'.   lv_field = 'SERIAL_NO'.
