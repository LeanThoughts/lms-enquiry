* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->CREATE_ITEM
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_TABNAME                     TYPE        TABNAME
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [--->] IO_DATA_PROVIDER               TYPE REF TO /IWBEP/IF_MGW_ENTRY_PROVIDER
* | [<-->] CS_ENTITY                      TYPE        ANY
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method create_item.
    data: lr_row    type ref to data,
          lr_header type ref to data,
          lv_zidno  type zde_id_no.
    field-symbols: <ls_row>    type any,
                   <ls_header> type any,
                   <lv_zidno>  type any,
                   <lv_itemid> type any,
                   <lv_bukrs>  type any,
                   <lv_ranl>   type any,
                   <lv_src>    type any,
                   <lv_ptlid>    type any.
    data lv_ptlid type zde_ptl_id.



    " payload into the entity structure, then into a DB row of the table
    io_data_provider->read_entry_data( importing es_data = cs_entity ).

    create data lr_row type (iv_tabname).
    assign lr_row->* to <ls_row>.
    move-corresponding cs_entity to <ls_row>.

    assign component 'ZID_NO'  of structure <ls_row> to <lv_zidno>.
    assign component 'ITEM_ID' of structure <ls_row> to <lv_itemid>.
    assign component 'BUKRS'   of structure <ls_row> to <lv_bukrs>.
    assign component 'RANL'    of structure <ls_row> to <lv_ranl>.
    assign component 'PTL_ID'  of structure <ls_row> to <lv_ptlid>.

    " parent key: from navigation (POST .../ToXxx) wins over the payload
    lv_zidno = get_key_zidno( it_key_tab ).
    if lv_zidno is not initial.
      <lv_zidno> = lv_zidno.
    endif.

    if <lv_bukrs> is initial.
       <lv_bukrs> = zcc_lms_constants=>company_code.
    endif.



    if <lv_ptlid>  is initial.
      mo_context->get_message_container( )->add_message_text_only(
        iv_msg_type = 'E' iv_msg_text = 'Portal Id (<lv_ptlid>) is required' ).
      raise exception type /iwbep/cx_mgw_busi_exception
        exporting message_container = mo_context->get_message_container( ).
    endif.

    " header must exist; inherit company code / contract from it when
    " the header table carries those fields
    create data lr_header type (c_tab_header).
    assign lr_header->* to <ls_header>.
    select single * from (c_tab_header) into <ls_header> where zid_no = <lv_zidno>.
    if sy-subrc <> 0.
      raise_not_found( iv_tabname = c_tab_header iv_key = <lv_zidno> ).
    endif.
    if <lv_bukrs> is initial.
      assign component 'BUKRS' of structure <ls_header> to <lv_src>.
      if sy-subrc = 0. <lv_bukrs> = <lv_src>. endif.
    endif.
    if <lv_ranl> is initial.
      assign component 'RANL' of structure <ls_header> to <lv_src>.
      if sy-subrc = 0. <lv_ranl> = <lv_src>. endif.
    endif.

    " key GUID (NFR 3)
    try.
        <lv_itemid> = cl_system_uuid=>create_uuid_x16_static( ).
      catch cx_uuid_error.
        raise exception type /iwbep/cx_mgw_tech_exception.
    endtry.

    set_admin_fields( exporting iv_create = abap_true changing cs_row = <ls_row> ).



    insert (iv_tabname) from <ls_row>.
    if sy-subrc <> 0.
      raise exception type /iwbep/cx_mgw_tech_exception.
    endif.

    write_change_doc( iv_tabname = iv_tabname iv_indicator = 'I'
                      is_new = <ls_row> is_old = <ls_row> ).

    " response = created row (incl. generated ItemId and admin fields)
    move-corresponding <ls_row> to cs_entity.
  endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->DELETE_ITEM
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_TABNAME                     TYPE        TABNAME
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method delete_item.
    data: lr_old    type ref to data,
          lv_zidno  type zde_id_no,
          lv_itemid type guid_16,
          lv_key    type string,
          lv_itemid_c type char32.
    field-symbols <ls_old> type any.
    data lv_ptlid   type char40.

    lv_zidno  = get_key_zidno( it_key_tab ).
    lv_itemid = get_key_itemid( it_key_tab ).

    lv_ptlid = get_key_ptlid( it_key_tab = it_key_tab ).

    create data lr_old type (iv_tabname).
    assign lr_old->* to <ls_old>.

    select single * from (iv_tabname) into <ls_old>
      where zid_no = lv_zidno and ptlid = lv_ptlid.
    if sy-subrc <> 0.
      lv_itemid_c = lv_itemid.
      concatenate lv_zidno '/' lv_itemid_c into lv_key.
      raise_not_found( iv_tabname = iv_tabname iv_key = lv_key ).
    endif.

    delete (iv_tabname) from <ls_old>.
    if sy-subrc <> 0.
      raise exception type /iwbep/cx_mgw_tech_exception.
    endif.

    write_change_doc( iv_tabname = iv_tabname iv_indicator = 'D'
                      is_new = <ls_old> is_old = <ls_old> ).
  endmethod.


