* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->BUILD_WHERE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_ZIDNO                       TYPE        ZDE_ID_NO(optional)
* | [--->] IV_ITEMID                      TYPE        GUID_16(optional)
* | [--->] IT_FILTER_SO                   TYPE        /IWBEP/T_MGW_SELECT_OPTION(optional)
* | [<-()] RV_WHERE                       TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method build_where.
    " Combines parent key / item key with the $filter select-options.
    " $filter property names are EDM names; map the ones we allow here.
    data: ls_so    like line of it_filter_so,
          ls_rng   type /iwbep/s_cod_select_option,
          lt_where type table of string,
          lv_cond  type string,
          lv_field type fieldname,
          lv_low   type string.

    if iv_zidno is not initial.
      concatenate 'ZID_NO = ''' iv_zidno '''' into lv_cond.
      append lv_cond to lt_where.
    endif.
    if iv_itemid is not initial.
      lv_low = iv_itemid.
      concatenate 'ITEM_ID = ''' lv_low '''' into lv_cond.
      append lv_cond to lt_where.
    endif.

    loop at it_filter_so into ls_so.
      " EDM property -> DDIC field (CamelCase -> upper snake)
      case ls_so-property.
        when 'ZidNo'.      lv_field = 'ZID_NO'.
        when 'Bukrs'.      lv_field = 'BUKRS'.
        when 'Ranl'.       lv_field = 'RANL'.
        when 'ItemId'.     lv_field = 'ITEM_ID'.
        when 'DocType'.    lv_field = 'DOC_TYPE'.
        when 'DocStage'.   lv_field = 'DOC_STAGE'.
        when 'EventType'.  lv_field = 'EVENT_TYPE'.
        when 'CovBasis'.   lv_field = 'COV_BASIS'.
        when others.
          " not filterable in the DB - ignore (or raise if strict)
          continue.
      endcase.

      loop at ls_so-select_options into ls_rng.
        if ls_rng-option = 'EQ'.
          concatenate lv_field ' = ''' ls_rng-low '''' into lv_cond.
        elseif ls_rng-option = 'BT'.
          concatenate lv_field ' BETWEEN ''' ls_rng-low ''' AND ''' ls_rng-high '''' into lv_cond.
        elseif ls_rng-option = 'CP'.
          replace all occurrences of '*' in ls_rng-low with '%'.
          concatenate lv_field ' LIKE ''' ls_rng-low '''' into lv_cond.
        else.
          concatenate lv_field ' ' ls_rng-option ' ''' ls_rng-low '''' into lv_cond.
        endif.
        append lv_cond to lt_where.
      endloop.
    endloop.

    clear rv_where.
    loop at lt_where into lv_cond.
      if rv_where is initial.
        rv_where = lv_cond.
      else.
        concatenate rv_where 'AND' lv_cond into rv_where separated by space.
      endif.
    endloop.
  endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Protected Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->CHECKLISTHEADERS_CREATE_ENTITY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_ENTITY_NAME                 TYPE        STRING
* | [--->] IV_ENTITY_SET_NAME             TYPE        STRING
* | [--->] IV_SOURCE_NAME                 TYPE        STRING
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [--->] IO_TECH_REQUEST_CONTEXT        TYPE REF TO /IWBEP/IF_MGW_REQ_ENTITY_C(optional)
* | [--->] IT_NAVIGATION_PATH             TYPE        /IWBEP/T_MGW_NAVIGATION_PATH
* | [--->] IO_DATA_PROVIDER               TYPE REF TO /IWBEP/IF_MGW_ENTRY_PROVIDER(optional)
* | [<---] ER_ENTITY                      TYPE        ZCL_ZPFS_LMS_COLLATERA_MPC=>TS_CHECKLISTHEADER
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method checklistheaders_create_entity.
    data lv_msg_text  type bapi_msg.

    constants:
      lc_source_portal type zpfs_ln_chklt_dt-sourceofentry value 'PORTAL'.

    data:
      ls_entity   type zcl_zpfs_lms_collatera_mpc=>ts_checklistheader,
      ls_chklst   type zpfs_ln_chklt_dt,
      ls_existing type zpfs_ln_chklt_dt,
      lv_exists   type abap_bool,
      lv_ts       type timestamp,
      lv_subrc    type string,
      lv_text     type string,
      lo_msg      type ref to /iwbep/if_message_container.

    lo_msg = mo_context->get_message_container( ).

*-- 1. Read the posted entity
    io_data_provider->read_entry_data( importing es_data = ls_entity ).

*-- 2. Mandatory fields
    if ls_entity-zloan_number is initial.
      lo_msg->add_message_text_only(
        exporting
          iv_msg_type = /iwbep/cl_cos_logger=>error
          iv_msg_text = 'Loan contract number (ZLOAN_NUMBER) is mandatory for a collateral item.' ).
      raise exception type /iwbep/cx_mgw_busi_exception
        exporting
          message_container = lo_msg
          http_status_code  = /iwbep/cx_mgw_busi_exception=>gcs_http_status_codes-bad_request.
    endif.

    if ls_entity-zid_no is initial.
      lo_msg->add_message_text_only(
        exporting
          iv_msg_type = /iwbep/cl_cos_logger=>error
          iv_msg_text = 'Checklist ID No. (ZID_NO) is mandatory for a collateral item.' ).
      raise exception type /iwbep/cx_mgw_busi_exception
        exporting
          message_container = lo_msg
          http_status_code  = /iwbep/cx_mgw_busi_exception=>gcs_http_status_codes-bad_request.
    endif.

*-- 3. Normalise the key: CHAR10 with leading zeros
    call function 'CONVERSION_EXIT_ALPHA_INPUT'
      exporting
        input  = ls_entity-zid_no
      importing
        output = ls_entity-zid_no.

*-- 4. Does the row exist already (re-post after a lost response)?
    select single *
      from zpfs_ln_chklt_dt
      into ls_existing
      where zid_no = ls_entity-zid_no.
    if sy-subrc = 0.
      lv_exists = abap_true.
    endif.

*-- 5. Map the entity to the table row
    move-corresponding ls_entity to ls_chklst.
    ls_chklst-mandt = sy-mandt.

    if ls_chklst-sourceofentry is initial.
      ls_chklst-sourceofentry = lc_source_portal.
    endif.

*-- 6. Audit fields
    get time stamp field lv_ts.
    if lv_exists = abap_true.
      " keep the original creation stamp, record this as a change
      ls_chklst-created_by = ls_existing-created_by.
      ls_chklst-created_at = ls_existing-created_at.
      ls_chklst-changed_by = sy-uname.
      ls_chklst-changed_at = lv_ts.
    else.
      ls_chklst-created_by = sy-uname.
      ls_chklst-created_at = lv_ts.
      clear: ls_chklst-changed_by, ls_chklst-changed_at.
    endif.
    ls_chklst-zapplicable = abap_true.
    ls_chklst-ptl_id      = ls_entity-portal_id.
*-- 7. Write
    if lv_exists = abap_true.
      update zpfs_ln_chklt_dt from ls_chklst.
    else.
      insert zpfs_ln_chklt_dt from ls_chklst.
    endif.

    if sy-subrc <> 0.
      lv_subrc = sy-subrc.
      condense lv_subrc.
      concatenate 'Collateral checklist item' ls_chklst-zid_no
                  'could not be saved (sy-subrc' lv_subrc ').'
        into lv_text separated by space.
      lv_msg_text = lv_text.
      lo_msg->add_message_text_only(
        exporting
          iv_msg_type = /iwbep/cl_cos_logger=>error
          iv_msg_text = lv_msg_text ).
      raise exception type /iwbep/cx_mgw_tech_exception
        exporting
          message_container = lo_msg.
    endif.

*-- 8. Return the stored row as the created entity
    move-corresponding ls_chklst to er_entity.

    auto_generate_collaterals( is_chklist = ls_chklst ).


  endmethod.


