* | [<---] ES_RESPONSE_CONTEXT            TYPE        /IWBEP/IF_MGW_APPL_SRV_RUNTIME=>TY_S_MGW_RESPONSE_CONTEXT
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method checklistheaders_get_entityset.
    data: lv_where type string,
          lv_count type i.

    lv_where = build_where( it_filter_so = it_filter_select_options ).

    select * from (c_tab_header) into corresponding fields of table et_entityset
      where (lv_where).

    " $orderby / $skip / $top on the result (small tables; for large
    " volumes push ORDER BY / UP TO into the SELECT instead)
    /iwbep/cl_mgw_data_util=>orderby( exporting it_order = it_order
                                      changing  ct_data  = et_entityset ).
    if is_paging-top > 0 or is_paging-skip > 0.
      lv_count = lines( et_entityset ).
      /iwbep/cl_mgw_data_util=>paging( exporting is_paging = is_paging
                                       changing  ct_data   = et_entityset ).
    else.
      lv_count = lines( et_entityset ).
    endif.
    if io_tech_request_context->has_inlinecount( ) = abap_true.
      es_response_context-inlinecount = lv_count.
    endif.
  endmethod.


