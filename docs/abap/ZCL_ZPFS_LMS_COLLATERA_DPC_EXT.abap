* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->GET_DOC_DETAILS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [<---] ES_DOC                         TYPE        ZCL_LMS_PORTAL_BDS_DOC_UTIL=>TY_UPLOAD_DOC
* | [<---] EV_CHECKLIST_ID                TYPE        ZDE_ID_NO
* | [<---] EV_BUSINESS_OBJECT_NAME        TYPE        CHAR80
* | [<---] EV_ENTITY_ID                   TYPE        CHAR40
* +--------------------------------------------------------------------------------------</SIGNATURE>
method get_doc_details.

  data lv_business_object_name type char80.
  data lv_id_no                 type zde_id_no.
  data lv_bukrs type bukrs.
  data lv_ranl  type ranl.
  data lo_bds_doc_util type ref to zcl_lms_portal_bds_doc_util.
  data lv_checklist_id type char40.
  data lv_entity_id type char40.
  data ls_key_tab like line of it_key_tab.

  loop at it_key_tab into ls_key_tab.
    case ls_key_tab-name.
      when 'BusinessObjectName'.
        ev_business_object_name = ls_key_tab-value.
      when  'ZidNo'.
        ev_checklist_id  = ls_key_tab-value.
      when 'ItemId'.
        es_doc-object_id = ls_key_tab-value.
      when 'Bukrs'.
        if ls_key_tab-value is initial.
          es_doc-bukrs = zcc_lms_constants=>company_code.
        else.
          es_doc-bukrs = ls_key_tab-value.
        endif.
      when 'PtlId'.
        ev_entity_id  = ls_key_tab-value.
      when 'Ranl'.
        es_doc-ranl = ls_key_tab-value.
      when  'DocTypeDesc'.
        es_doc-doc_type_desc = ls_key_tab-value.
      when 'DocTitle'.
        es_doc-filename = ls_key_tab-value.
      when 'Remarks'.
        es_doc-remarks = ls_key_tab-value.
      when 'DocType'.
        es_doc-doc_type  = ls_key_tab-value.
      when 'PtlDocuId'.
        es_doc-portal_doc_id = ls_key_tab-value.
    endcase.
  endloop.

endmethod.


