* | Instance Protected Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->CHECKLISTHEADERS_UPDATE_ENTITY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_ENTITY_NAME                 TYPE        STRING
* | [--->] IV_ENTITY_SET_NAME             TYPE        STRING
* | [--->] IV_SOURCE_NAME                 TYPE        STRING
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [--->] IO_TECH_REQUEST_CONTEXT        TYPE REF TO /IWBEP/IF_MGW_REQ_ENTITY_U(optional)
* | [--->] IT_NAVIGATION_PATH             TYPE        /IWBEP/T_MGW_NAVIGATION_PATH
* | [--->] IO_DATA_PROVIDER               TYPE REF TO /IWBEP/IF_MGW_ENTRY_PROVIDER(optional)
* | [<---] ER_ENTITY                      TYPE        ZCL_ZPFS_LMS_COLLATERA_MPC=>TS_CHECKLISTHEADER
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method checklistheaders_update_entity.
    data: ls_payload type zcl_zpfs_lms_collatera_mpc=>ts_checklistheader,
          ls_db      type zpfs_ln_chklt_dt,
          ls_old     type zpfs_ln_chklt_dt,
          lv_zidno   type zde_id_no.
    field-symbols: <lv_fld> type any,
                   <lv_src> type any.

    lv_zidno = get_key_zidno( it_key_tab ).
    io_data_provider->read_entry_data( importing es_data = ls_payload ).

    select single * from zpfs_ln_chklt_dt into ls_db where zid_no = lv_zidno.
    if sy-subrc <> 0.
      raise_not_found( iv_tabname = c_tab_header iv_key = lv_zidno ).
    endif.
    ls_old = ls_db.

    " payload overwrites non-key fields; key and creation stamps are kept
    move-corresponding ls_payload to ls_db.
    ls_db-zid_no = lv_zidno.
    assign component 'CREATED_BY' of structure ls_db  to <lv_fld>.
    if sy-subrc = 0.
      assign component 'CREATED_BY' of structure ls_old to <lv_src>. <lv_fld> = <lv_src>.
      assign component 'CREATED_AT' of structure ls_db  to <lv_fld>.
      assign component 'CREATED_AT' of structure ls_old to <lv_src>. <lv_fld> = <lv_src>.
    endif.
    set_admin_fields( exporting iv_create = abap_false changing cs_row = ls_db ).
    ls_db-zapplicable = abap_true.
    ls_db-ptl_id      = ls_payload-portal_id.

    update zpfs_ln_chklt_dt from ls_db.
    write_change_doc( iv_tabname = c_tab_header iv_indicator = 'U'
                      is_new = ls_db is_old = ls_old ).

    move-corresponding ls_db to er_entity.

    auto_generate_collaterals( is_chklist = ls_db ).
  endmethod.


