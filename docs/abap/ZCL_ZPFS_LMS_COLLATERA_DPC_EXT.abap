* | [<---] ER_ENTITY                      TYPE        ZCL_ZPFS_LMS_COLLATERA_MPC=>TS_COLLATERALOBJECTTYPEAGREEME
* | [<---] ES_RESPONSE_CONTEXT            TYPE        /IWBEP/IF_MGW_APPL_SRV_RUNTIME=>TY_S_MGW_RESPONSE_ENTITY_CNTXT
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
method collateralobject_get_entity.

*----------------------------------------------------------------------*
* Derive the collateral agreement type for a collateral object type.
* Entity structure: ZLMS_STR_COLL_AGMT_TYPE_OBJECT
*   key    : COL_OBJ     (collateral object type, ZDE_OBJ_TYPE)
*   output : CAGMT_TYPE  (CMS_DTE_CAG_TYP), CAGMT_NAME (description)
*----------------------------------------------------------------------*
  data: ls_key      type /iwbep/s_mgw_name_value_pair,
        lv_col_obj  type zde_obj_type,
        lo_derive   type ref to zcl_cms_auto_gen_coll_chklist,
        lv_msg      type bapi_msg.
  data lo_msg type ref to /iwbep/if_message_container.
  lo_msg = mo_context->get_message_container( ).
  clear er_entity.

*-- 1. Key from URL: ...CollateralObjectSet('ZRE001')
  read table it_key_tab into ls_key with key name = 'CollObjectType'.   "EDM name of key
  if sy-subrc <> 0.
    " fall back: single-key entity -> take the first key whatever its name
    read table it_key_tab into ls_key index 1.
  endif.
  if sy-subrc <> 0 or ls_key-value is initial.
    lv_msg = 'Collateral object type (key) is missing'.
    lo_msg->add_message_text_only(
          iv_msg_type = /iwbep/cl_cos_logger=>error
          iv_msg_text = lv_msg ).
            raise exception type /iwbep/cx_mgw_busi_exception
              exporting
                message_container = lo_msg.
  endif.
  lv_col_obj = ls_key-value.
  translate lv_col_obj to upper case.

*-- 2. Derive the agreement type (same logic as checklist auto-generation)
  create object lo_derive.
  er_entity-coll_object_type    = lv_col_obj.
  er_entity-cagmt_type = lo_derive->derive_cagmt_type( lv_col_obj ).

  if er_entity-cagmt_type is initial.
    concatenate 'No collateral agreement type found for object type' lv_col_obj
           into lv_msg separated by space.
    lo_msg->add_message_text_only(
          iv_msg_type = /iwbep/cl_cos_logger=>error
          iv_msg_text = lv_msg ).
            raise exception type /iwbep/cx_mgw_busi_exception
              exporting
                message_container = lo_msg.
  endif.

**-- 3. Description of the agreement type
  select single name from tcms_cag_typ_t
    into er_entity-cagmt_type_desc
    where cagmt_type = er_entity-cagmt_type
      and language   = sy-langu.
  if sy-subrc <> 0.
    select single name from tcms_cag_typ_t
      into er_entity-cagmt_type_desc
      where cagmt_type = er_entity-cagmt_type
        and language   = 'E'.
  endif.

endmethod.


