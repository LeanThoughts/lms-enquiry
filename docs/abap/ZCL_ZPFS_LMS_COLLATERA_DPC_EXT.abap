* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->UPDATE_ITEM
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_TABNAME                     TYPE        TABNAME
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR
* | [--->] IO_DATA_PROVIDER               TYPE REF TO /IWBEP/IF_MGW_ENTRY_PROVIDER
* | [<-->] CS_ENTITY                      TYPE        ANY
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method update_item.
    data: lr_row    type ref to data,
          lr_old    type ref to data,
          lv_zidno  type zde_id_no,
          lv_itemid type guid_16,
          lv_key    type string,
          lv_ptlid  type char40,
          lv_itemid_c type char32.
    field-symbols: <ls_row> type any,
                   <ls_old> type any,
                   <lv_fld> type any,
                   <lv_src> type any ,
                   <lv_old_item_id> type any.

    lv_zidno  = get_key_zidno( it_key_tab ).
    "lv_itemid = get_key_itemid( it_key_tab ).
    lv_ptlid = get_key_ptlid( it_key_tab ).

    create data lr_row type (iv_tabname).
    create data lr_old type (iv_tabname).
    assign lr_row->* to <ls_row>.
    assign lr_old->* to <ls_old>.

    select single * from (iv_tabname) into <ls_row>
      where zid_no = lv_zidno and ptl_id = lv_ptlid.
    if sy-subrc <> 0.
      lv_itemid_c = lv_ptlid.
      concatenate lv_zidno '/' lv_itemid_c  into lv_key.
      raise_not_found( iv_tabname = iv_tabname iv_key = lv_key ).
    endif.
    <ls_old> = <ls_row>.

    data lv_item_id_old type guid_16.
    assign component 'ITEM_ID'    of structure <ls_old> to <lv_old_item_id>.


    " payload overwrites non-key, non-admin fields
    io_data_provider->read_entry_data( importing es_data = cs_entity ).
    move-corresponding cs_entity to <ls_row>.

    " restore protected fields
    assign component 'ZID_NO'     of structure <ls_row> to <lv_fld>. <lv_fld> = lv_zidno.
    assign component 'ITEM_ID'    of structure <ls_row> to <lv_fld>. <lv_fld> = <lv_old_item_id>.
    assign component 'CREATED_BY' of structure <ls_row> to <lv_fld>.
    assign component 'CREATED_BY' of structure <ls_old> to <lv_src>. <lv_fld> = <lv_src>.
    assign component 'CREATED_AT' of structure <ls_row> to <lv_fld>.
    assign component 'CREATED_AT' of structure <ls_old> to <lv_src>. <lv_fld> = <lv_src>.

    set_admin_fields( exporting iv_create = abap_false changing cs_row = <ls_row> ).

    update (iv_tabname) from <ls_row>.
    if sy-subrc <> 0.
      raise exception type /iwbep/cx_mgw_tech_exception.
    endif.

    write_change_doc( iv_tabname = iv_tabname iv_indicator = 'U'
                      is_new = <ls_row> is_old = <ls_old> ).

    move-corresponding <ls_row> to cs_entity.
  endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->WRITE_CHANGE_DOC
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_TABNAME                     TYPE        TABNAME
* | [--->] IV_INDICATOR                   TYPE        CDCHNGIND
* | [--->] IS_NEW                         TYPE        ANY
* | [--->] IS_OLD                         TYPE        ANY
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method write_change_doc.
    " NFR 1: change documents for create / update / delete.
    " Replace with the FM generated by SCDO for your change-document
    " object (one object per table, or one object with all seven tables).
    " Signature pattern of a generated FM:
    "   OBJECTID, TCODE, UTIME, UDATE, USERNAME, OBJECT_CHANGE_INDICATOR,
    "   UPD_<table>, N_<table>, O_<table>, ICDTXT_<object>
    " The document is written with the Gateway commit (same LUW).
    "
    " CALL FUNCTION 'ZPFS_LMS_COLLATERAL_WRITE_DOC'
    "   EXPORTING objectid = ... tcode = sy-tcode utime = sy-uzeit
    "             udate = sy-datum username = sy-uname
    "             object_change_indicator = iv_indicator
    "             ...
  endmethod.
endclass.