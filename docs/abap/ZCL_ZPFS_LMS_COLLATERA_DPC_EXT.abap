* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->SET_ADMIN_FIELDS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_CREATE                      TYPE        ABAP_BOOL
* | [<-->] CS_ROW                         TYPE        ANY
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method set_admin_fields.
    " CMS_STR_CHG_HISTORY: CREATED_BY/AT, CHANGED_BY/AT, SOURCEOFENTRY
    data lv_ts type timestamp.
    field-symbols <lv> type any.

    get time stamp field lv_ts.

    if iv_create = abap_true.
      assign component 'CREATED_BY' of structure cs_row to <lv>.
      if sy-subrc = 0. <lv> = sy-uname. endif.
      assign component 'CREATED_AT' of structure cs_row to <lv>.
      if sy-subrc = 0. <lv> = lv_ts. endif.
    endif.
    assign component 'CHANGED_BY' of structure cs_row to <lv>.
    if sy-subrc = 0. <lv> = sy-uname. endif.
    assign component 'CHANGED_AT' of structure cs_row to <lv>.
    if sy-subrc = 0. <lv> = lv_ts. endif.
    assign component 'SOURCEOFENTRY' of structure cs_row to <lv>.
    if sy-subrc = 0 and <lv> is initial. <lv> = 'PORTAL'. endif.
  endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->UPDATE_ENTITY_CHECKLIST_HEADER
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_DOC                         TYPE        ZCL_LMS_PORTAL_BDS_DOC_UTIL=>TY_UPLOAD_DOC
* | [--->] IV_CHECKLIST_ID                TYPE        ZDE_ID_NO
* | [--->] IV_BUSINESS_OBJECT_NAME        TYPE        CHAR80
* | [--->] IV_ENTITY_ID                   TYPE        CHAR40
* | [--->] IV_BDS_COMP_ID                 TYPE        BDS_COMPID
* +--------------------------------------------------------------------------------------</SIGNATURE>
method update_entity_checklist_header.
  data ls_chklt_dt type zpfs_ln_chklt_dt.
  data:
     ls_entity   type zcl_zpfs_lms_collatera_mpc=>ts_checklistheader,
     lo_msg      type ref to /iwbep/if_message_container.

  lo_msg = mo_context->get_message_container( ).

  select single * from zpfs_ln_chklt_dt into ls_chklt_dt where zid_no = iv_checklist_id.
  if sy-subrc <> 0.
    lo_msg->add_message_text_only(
      exporting
        iv_msg_type = /iwbep/cl_cos_logger=>error
        iv_msg_text = 'Checklist id (IV_CHECKLIST_ID) not found for loan (IS_DOC-RANL)' ).
    raise exception type /iwbep/cx_mgw_busi_exception
      exporting
        message_container = lo_msg
        http_status_code  = /iwbep/cx_mgw_busi_exception=>gcs_http_status_codes-bad_request.
  endif.

  ls_chklt_dt-zapplicable           = abap_true.
  ls_chklt_dt-post_exec_doc_type    = is_doc-doc_type.
  ls_chklt_dt-post_exec_doc_name    = is_doc-filename.
  ls_chklt_dt-post_exec_doc_title   = is_doc-doc_title.
  ls_chklt_dt-post_exec_bds_doc_id  = iv_bds_comp_id..
  ls_chklt_dt-post_exec_portal_doc_id = is_doc-portal_doc_id .

  modify zpfs_ln_chklt_dt from ls_chklt_dt.
  if sy-subrc <> 0.
    lo_msg->add_message_text_only(
      exporting
        iv_msg_type = /iwbep/cl_cos_logger=>error
        iv_msg_text = 'Error updating zpfs_ln_chklt_dt with ID (IV_CHECKLIST_ID) for loan (IS_DOC-RANL)' ).
    raise exception type /iwbep/cx_mgw_busi_exception
      exporting
        message_container = lo_msg
        http_status_code  = /iwbep/cx_mgw_busi_exception=>gcs_http_status_codes-bad_request.
  endif.

endmethod.


