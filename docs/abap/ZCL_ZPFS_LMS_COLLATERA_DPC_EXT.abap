* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_ZPFS_LMS_COLLATERA_DPC_EXT->/IWBEP/IF_MGW_APPL_SRV_RUNTIME~GET_EXPANDED_ENTITY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_ENTITY_NAME                 TYPE        STRING(optional)
* | [--->] IV_ENTITY_SET_NAME             TYPE        STRING(optional)
* | [--->] IV_SOURCE_NAME                 TYPE        STRING(optional)
* | [--->] IT_KEY_TAB                     TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR(optional)
* | [--->] IT_NAVIGATION_PATH             TYPE        /IWBEP/T_MGW_NAVIGATION_PATH(optional)
* | [--->] IO_EXPAND                      TYPE REF TO /IWBEP/IF_MGW_ODATA_EXPAND(optional)
* | [--->] IO_TECH_REQUEST_CONTEXT        TYPE REF TO /IWBEP/IF_MGW_REQ_ENTITY(optional)
* | [<---] ER_ENTITY                      TYPE REF TO DATA
* | [<---] ES_RESPONSE_CONTEXT            TYPE        /IWBEP/IF_MGW_APPL_SRV_RUNTIME=>TY_S_MGW_RESPONSE_ENTITY_CNTXT
* | [<---] ET_EXPANDED_CLAUSES            TYPE        STRING_TABLE
* | [<---] ET_EXPANDED_TECH_CLAUSES       TYPE        STRING_TABLE
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method /iwbep/if_mgw_appl_srv_runtime~get_expanded_entity.
    data: ls_deep  type ty_header_deep,
          lv_zidno type zde_id_no,
          lv_where type string.

    if iv_entity_set_name <> 'ChecklistHeaderSet'.
      " other sets: default behaviour (framework calls GET_ENTITY + navs)
      super->/iwbep/if_mgw_appl_srv_runtime~get_expanded_entity(
        exporting iv_entity_name = iv_entity_name iv_entity_set_name = iv_entity_set_name
                  iv_source_name = iv_source_name it_key_tab = it_key_tab
                  it_navigation_path = it_navigation_path io_expand = io_expand
                  io_tech_request_context = io_tech_request_context
        importing er_entity = er_entity es_response_context = es_response_context
                  et_expanded_clauses = et_expanded_clauses
                  et_expanded_tech_clauses = et_expanded_tech_clauses ).
      return.
    endif.

    lv_zidno = get_key_zidno( it_key_tab ).

    select single * from (c_tab_header) into corresponding fields of ls_deep
      where zid_no = lv_zidno.
    if sy-subrc <> 0.
      raise_not_found( iv_tabname = c_tab_header iv_key = lv_zidno ).
    endif.

    " all six item tables of this header (cheap: one key access each);
    " the serializer only outputs the navigations named in $expand
    lv_where = build_where( iv_zidno = lv_zidno ).
    select * from (c_tab_cov)    into corresponding fields of table ls_deep-tocoverage     where (lv_where).
    select * from (c_tab_doc)    into corresponding fields of table ls_deep-todocuments    where (lv_where).
    select * from (c_tab_secpos) into corresponding fields of table ls_deep-tosecpositions where (lv_where).
    select * from (c_tab_cersai) into corresponding fields of table ls_deep-tocersai       where (lv_where).
    select * from (c_tab_nesl)   into corresponding fields of table ls_deep-tonesl         where (lv_where).
    select * from (c_tab_roc)    into corresponding fields of table ls_deep-toroc          where (lv_where).

    " tell the framework these navigations are already filled
    append 'TOCOVERAGE'     to et_expanded_tech_clauses.
    append 'TODOCUMENTS'    to et_expanded_tech_clauses.
    append 'TOSECPOSITIONS' to et_expanded_tech_clauses.
    append 'TOCERSAI'       to et_expanded_tech_clauses.
    append 'TONESL'         to et_expanded_tech_clauses.
    append 'TOROC'          to et_expanded_tech_clauses.

    copy_data_to_ref( exporting is_data = ls_deep changing cr_data = er_entity ).
  endmethod.


